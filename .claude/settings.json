{
  "enabledPlugins": {
    "expo@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "enableAllProjectMcpServers": false,
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "WebSearch",
      "WebFetch(domain:docs.expo.dev)",
      "WebFetch(domain:reactnative.dev)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:code.claude.com)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git merge --ff-only *)",
      "Bash(git merge --abort)",
      "Bash(git stash *)",
      "Bash(git restore --staged *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npm ls *)",
      "Bash(npm view *)",
      "Bash(npx expo start *)",
      "Bash(npx expo export *)",
      "Bash(npx expo install *)",
      "Bash(npx expo config *)",
      "Bash(npx expo-doctor *)",
      "Bash(npx tsc *)",
      "Bash(npx playwright test -c playwright.logic.config.ts *)",
      "Bash(node scripts/env-check.cjs *)",
      "Bash(python .claude/skills/ui-ux-pro-max/scripts/*)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git switch *)",
      "PowerShell(git fetch *)",
      "PowerShell(git merge --ff-only *)",
      "PowerShell(git stash *)",
      "PowerShell(npm run *)",
      "PowerShell(npm ci)",
      "PowerShell(npx expo start *)",
      "PowerShell(npx expo export *)",
      "PowerShell(npx expo install *)",
      "PowerShell(npx tsc *)",
      "PowerShell(npx playwright test -c playwright.logic.config.ts *)",
      "PowerShell(node scripts/env-check.cjs *)",
      "mcp__firecrawl__firecrawl_scrape",
      "mcp__firecrawl__firecrawl_search",
      "mcp__plugin_playwright_playwright__*"
    ],
    "deny": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git pull *)",
      "PowerShell(git pull *)",
      "Bash(git rebase *)",
      "PowerShell(git rebase *)",
      "Bash(git reset --hard *)",
      "PowerShell(git reset --hard *)",
      "Bash(git clean *)",
      "PowerShell(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D *)",
      "Bash(git tag -d *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git remote remove *)",
      "Bash(git config --global *)",
      "Bash(git config --system *)",
      "Bash(git filter-branch *)",
      "Bash(git update-ref *)",
      "Bash(git reflog expire *)",
      "Bash(supabase *)",
      "PowerShell(supabase *)",
      "Bash(npx supabase *)",
      "PowerShell(npx supabase *)",
      "Bash(eas *)",
      "Bash(npx eas-cli *)",
      "Bash(npx eas *)",
      "Bash(npx expo submit *)",
      "Bash(npm publish *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "PowerShell(curl *)",
      "PowerShell(wget *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "PowerShell(Remove-Item *-Recurse*)",
      "mcp__supabase__*",
      "mcp__*supabase*",
      "mcp__*Supabase*",
      "mcp__*__apply_migration",
      "mcp__*__execute_sql",
      "mcp__*__deploy_edge_function",
      "mcp__*__merge_pull_request",
      "mcp__*__create_or_update_file",
      "mcp__*__create_pull_request",
      "mcp__github__push_files",
      "mcp__plugin_playwright_playwright__browser_run_code_unsafe",
      "Read(/.env*)",
      "Edit(/.env*)",
      "Edit(/.claude/settings*.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.mcp.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.cjs\""
          }
        ]
      }
    ]
  }
}
